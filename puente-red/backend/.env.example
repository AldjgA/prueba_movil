# Variables de entorno del backend. Copiar a `.env` y rellenar EN LOCAL.
# NUNCA se commitea `.env` (está en .gitignore).

# Puerto de escucha.
PORT=8080

# --- Supabase (región sa-east-1, la más cercana a La Paz) — PR-INFRA §5 ---
# La service role key es SECRETA: solo en el servidor, jamás en el APK ni en el portal.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google GenAI (PR-INFRA §4) ---
# ⚠️ La capa GRATUITA puede usar los prompts para mejorar productos de Google.
# Prohibida con datos reales de menores: usar la capa DE PAGO.
GOOGLE_GENAI_API_KEY=

# --- Clasificador (PR-005) ---
# 'on'  = clasifica con el LLM (capa de pago).
# 'off' = desactivado: todo entra como ALTO y el caso NO se bloquea.
# La demo funciona con 'off' porque no hay datos (PR-003 Q7).
CLASSIFIER_MODE=off
