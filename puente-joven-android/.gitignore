.verify-designer/
.isolated-build/

# Caché de Gradle generada en el sandbox (rutas largas rompen `git add`)
.gh/

# Configuración local (rutas del SDK del usuario)
local.properties

# IDE
*.iml
*.ipr
*.iws
.idea/
.DS_Store
Thumbs.db

# APKs / artefactos binarios (se regeneran con el build)
*.apk
*.aab
*.ap_

